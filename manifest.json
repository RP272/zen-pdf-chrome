{
    "name": "ZenPDF",
    "description": "Extension for hiding toolbar from the top of PDF viewer in Google Chrome",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": "images/zen-pdf-logo.png"
    },
    "content_scripts": [
        {
            "js": [
                "scripts/content.js"
            ],
            "matches": [
                "https://developer.chrome.com/docs/extensions/*",
                "https://developer.chrome.com/docs/webstore/*",
                "file:///*.pdf"
            ]
        }
    ],
    "commands": {
        "toggle-toolbar": {
            "suggested_key": {
                "default": "Alt+Z"
            },
            "description": "Toggle PDF toolbar"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "scripting"
    ]
}